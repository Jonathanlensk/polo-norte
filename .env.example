PORT=3000
NODE_ENV=development

# =========================================
# MERCADO PAGO
# =========================================
# Nunca coloque o Access Token no frontend ou no GitHub.
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-COLOQUE_SEU_ACCESS_TOKEN_AQUI
MERCADO_PAGO_PUBLIC_KEY=TEST-COLOQUE_SUA_PUBLIC_KEY_AQUI

# =========================================
# POSTGRESQL
# =========================================
PGHOST=localhost
PGPORT=5432
PGDATABASE=polo_norte
PGUSER=postgres
PGPASSWORD=COLOQUE_SUA_SENHA_DO_POSTGRES_AQUI

# Gere uma chave longa e aleatória para produção.
JWT_SECRET=COLOQUE_UMA_CHAVE_FORTE_AQUI
