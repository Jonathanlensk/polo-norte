PORT=3000
NODE_ENV=development

# =========================================
# MERCADO PAGO
# =========================================
# Nunca coloque o Access Token no frontend ou no GitHub.
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-COLOQUE_SEU_ACCESS_TOKEN_AQUI
MERCADO_PAGO_PUBLIC_KEY=TEST-COLOQUE_SUA_PUBLIC_KEY_AQUI

# =========================================
# POSTGRESQL
# =========================================
PGHOST=localhost
PGPORT=5432
PGDATABASE=polo_norte
PGUSER=postgres
PGPASSWORD=COLOQUE_SUA_SENHA_DO_POSTGRES_AQUI

# Gere uma chave longa e aleatória para produção.
JWT_SECRET=COLOQUE_UMA_CHAVE_FORTE_AQUI

# =========================================
# ENTREGA AUTOMÁTICA
# =========================================
# Enquanto você não definir o preço por km, deixe 0.00.
# O sistema já calcula distância e previsão; a taxa ficará grátis.
DELIVERY_PRICE_PER_KM=0.00
DELIVERY_MIN_FEE=0.00
DELIVERY_MAX_DISTANCE_KM=15
DELIVERY_WINDOW_MINUTES=10

# =========================================
# GTEX ERP
# =========================================
# Servidor informado pela GTEX. O login e a senha ficam somente no backend.
GTEX_ENABLED=false
# Pode ficar true mesmo enquanto GTEX_ENABLED=false: sincroniza apenas catálogo/preço/estoque.
GTEX_CATALOG_SYNC_ENABLED=true
GTEX_URL=http://201.20.59.15:7773
GTEX_USER=COLOQUE_SEU_USUARIO_GTEX_AQUI
GTEX_PASSWORD=COLOQUE_SUA_SENHA_GTEX_AQUI

# Mapeamento confirmado das lojas Polo Norte -> GTEX
GTEX_FILIAL_JULIO=1
GTEX_FILIAL_DIVINO=4
GTEX_FILIAL_VILA=5

# Cliente padrão do e-commerce no ERP
GTEX_CODCLI=2

# A documentação GTEX aceita 1 quando não há vendedor específico.
# Troque pelo vendedor escolhido na rotina 2001 antes da entrega final.
GTEX_CODVENDEDOR=1
GTEX_ORIGEMVENDA=VE

# Preencha com os códigos REAIS da base da Polo Norte (rotas gtex_plpag / gtex_cob).
GTEX_PIX_CODPLPAG=
GTEX_PIX_CODCOB=
GTEX_CREDIT_CODPLPAG=
GTEX_CREDIT_CODCOB=
GTEX_DEBIT_CODPLPAG=
GTEX_DEBIT_CODCOB=
GTEX_CASH_CODPLPAG=
GTEX_CASH_CODCOB=

# Taxa de entrega no ERP: se existir um produto "taxa de entrega", informe o código de barras.
# Se a GTEX orientar que a taxa deve ir somente na observação, deixe o barcode vazio e use true.
GTEX_DELIVERY_CODBARRA=
GTEX_ALLOW_DELIVERY_FEE_IN_OBS=false

# O sistema importa automaticamente produtos novos do GTEX e mantém
# cadastro GTEX, preço e estoque sincronizados nas filiais 1, 4 e 5.
# A primeira sincronização busca o histórico desde esta data.
GTEX_CATALOG_START_DATE=01/01/2000 00:00:00
# Reconsulta alguns minutos para trás para evitar perder alterações na virada do intervalo.
GTEX_SYNC_OVERLAP_MINUTES=15
# 0 desativa; exemplo: 10 = sincronizar a cada 10 minutos.
GTEX_SYNC_INTERVAL_MINUTES=10
GTEX_SYNC_ON_START=true
GTEX_TIMEOUT_MS=15000
GTEX_BULK_TIMEOUT_MS=120000
